{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QA Report",
  "type": "object",
  "required": [
    "status",
    "checks"
  ],
  "properties": {
    "status": {
      "enum": [
        "pass",
        "warning",
        "fail",
        "not_ready"
      ]
    },
    "checks": {
      "type": "array"
    }
  }
}